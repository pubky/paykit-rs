{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@synonymdev/react-native-paykit": ["./src/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    // ubrn's generated bindings and runtime sources have unused locals.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  // Includes the example app's sources, so CI type-checks its SDK calls and
  // callback mocks against the generated bindings. "paths" resolves the
  // package to ./src instead of the installed tarball.
  "exclude": ["example/node_modules", "lib", "node_modules"]
}
