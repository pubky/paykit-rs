{
  "name": "@synonymdev/react-native-paykit",
  "version": "0.1.0",
  "description": "React Native wrapper for Paykit SDK bindings",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "src/index",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run lint",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "rm -rf android/build ios/build lib",
    "prepare": "bob build",
    "prepack": "cd ../paykit-ffi && ./build.sh all && cd ../paykit-react-native && npm run update-bindings",
    "update-bindings": "./scripts/update-bindings.sh"
  },
  "keywords": [
    "paykit",
    "pubky",
    "react-native",
    "ios",
    "android",
    "payments"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubky/paykit-rs.git",
    "directory": "paykit-react-native"
  },
  "author": "Synonym <info@synonym.to>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pubky/paykit-rs/issues"
  },
  "homepage": "https://github.com/pubky/paykit-rs/tree/main/paykit-react-native#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@synonymdev/result": "^0.0.2"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.82.1",
    "@types/react": "^19.1.1",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "2.8.8",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-builder-bob": "^0.30.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  }
}
