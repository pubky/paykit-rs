@@ -50,0 +51,13 @@ private class VerificationResult(
+internal fun isExplicitlyRevoked(error: CertPathValidatorException): Boolean =
+    error.reason == CertPathValidatorException.BasicReason.REVOKED
+
+internal fun isRevocationStatusUnavailable(error: CertPathValidatorException): Boolean {
+    if (error.reason == CertPathValidatorException.BasicReason.UNDETERMINED_REVOCATION_STATUS) {
+        return true
+    }
+
+    return error.reason == CertPathValidatorException.BasicReason.UNSPECIFIED &&
+        generateSequence<Throwable>(error) { it.cause }
+            .any { it.message?.startsWith("No CRLs found for issuer ") == true }
+}
