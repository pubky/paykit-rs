@@ -0,0 +1,51 @@
+package org.rustls.platformverifier
+
+import java.security.cert.CertPathValidatorException
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CertificateVerifierUnitTests {
+    @Test
+    fun explicitRevocationFailsClosed() {
+        assertTrue(isExplicitlyRevoked(exception(CertPathValidatorException.BasicReason.REVOKED)))
+    }
+
+    @Test
+    fun unavailableRevocationStatusSoftFails() {
+        assertTrue(
+            isRevocationStatusUnavailable(
+                exception(
+                    CertPathValidatorException.BasicReason.UNDETERMINED_REVOCATION_STATUS
+                )
+            )
+        )
+    }
+
+    @Test
+    fun missingCrlSoftFails() {
+        assertTrue(
+            isRevocationStatusUnavailable(
+                exception(
+                    CertPathValidatorException.BasicReason.UNSPECIFIED,
+                    "No CRLs found for issuer cn=YE2,o=Let's Encrypt,c=US"
+                )
+            )
+        )
+    }
+
+    @Test
+    fun unrelatedValidatorFailureFailsClosed() {
+        assertFalse(
+            isRevocationStatusUnavailable(
+                exception(CertPathValidatorException.BasicReason.UNSPECIFIED)
+            )
+        )
+    }
+
+    private fun exception(
+        reason: CertPathValidatorException.Reason,
+        message: String = "test"
+    ): CertPathValidatorException =
+        CertPathValidatorException(message, null, null, -1, reason)
+}
